# Required in every environment: development, test, or production.
NODE_ENV=development
PORT=3000
SQLITE_PATH=./data.sqlite
# Production must use an absolute path on persistent storage and set this to 1.
BACKEND_REPLICA_COUNT=1
# If your host sets WEB_CONCURRENCY in production, it must also be 1.

OPENAI_API_KEY=
SERPER_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# When enabled, recipes missing publisher nutrition/time data get LLM estimates
# that are labeled as estimated instead of being dropped from results.
RECIPE_AI_ESTIMATION=true
RECIPE_ESTIMATION_MODEL=gpt-4o-mini

# Opt-in request logging for Pantrio AI (the backend's own key; BYO and
# on-device providers never reach this path). When "true", each chat round emits
# structured single-line JSON events, with images redacted and long text
# truncated:
#   pantrio_ai_chat_start   one per chat attempt, as soon as the request frame
#                           arrives and before auth or quota. A message that is
#                           refused still leaves a line, which is how "I sent a
#                           message and saw nothing" gets answered.
#   pantrio_ai_request      one per round, before the provider call. Carries the
#                           session, connection age (how early the client
#                           prewarmed its socket), and cache mode/breakpoint/TTL.
#   pantrio_ai_round_usage  one per round, after it returns. Carries prompt,
#                           completion, reasoning, and cached tokens, the cache
#                           hit ratio, and first-token time.
#   pantrio_ai_error_frame  every error frame sent to a client, with its code
#                           (AUTH_REQUIRED, QUOTA_EXHAUSTED, CHAT_BUSY, ...).
#   pantrio_ai_prewarm      reserved for a real prompt warm-up request; nothing
#                           emits it yet.
# Recipe diagnostics (recipeTrace.js) are gated by the same flag. Upstream
# errors stay logged even when this is off. Leave unset/empty in production.
LOG_AI_REQUESTS=false

# Interactive GPT-5.6 chat runs on the Responses API, which is the only way to
# combine reasoning with function tools on those models. Set to "false" to fall
# back to Chat Completions, where tool rounds run with reasoning disabled.
CHAT_RESPONSES_API=true

# Per-plan reasoning configuration for the Responses path (JSON, read at boot).
# Defaults to {"effort":"low","context":"current_turn","applyTo":"recommendRecipes"}.
# `applyTo` selects which rounds may reason; every other round sends "none":
#   "recommendRecipes" (default) - only the round that forces recommendRecipes
#   "first"                      - the original round-0-only behaviour
#   "all"                        - every round
# Example: {"default":{"effort":"low"},"pro":{"effort":"medium","context":"all_turns"}}
# Roll back the placement with: {"default":{"applyTo":"first"}}
REASONING_POLICY_JSON=

# Extra output budget added to a plan's completion cap for the provider request
# so reasoning tokens do not consume the user-visible answer budget. This is a
# safety limit only; plan.maxCompletionTokens still governs quota. Default 8000.
RESPONSES_REASONING_OUTPUT_ALLOWANCE=8000

APPLE_BUNDLE_ID=com.chilltech.pantrio
APPLE_APP_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY_BASE64=
APPLE_ROOT_CERTIFICATES_BASE64_JSON=[]
APPLE_ALLOWED_ENVIRONMENTS=Sandbox
APPLE_ALLOW_SANDBOX_IN_PRODUCTION=false

# Sign in with Apple web-service credentials used only to exchange and revoke
# login tokens. These are separate from the App Store/IAP credentials above.
APPLE_SIGN_IN_CLIENT_ID=com.chilltech.pantrio
APPLE_SIGN_IN_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY_BASE64=
# A separate random 32-byte key, base64 encoded (for example: openssl rand -base64 32).
APPLE_SIGN_IN_TOKEN_ENCRYPTION_KEY_BASE64=
APPLE_SIGN_IN_TOKEN_ENCRYPTION_KEY_ID=v1

# Omit this value to use the built-in monthly/yearly Pantrio Pro catalog.
# Keep it on one line when supplied through a hosting provider.
APPLE_SUBSCRIPTION_PLANS_JSON=
