# Required in every environment: development, test, or production.
NODE_ENV=development
PORT=3000
SQLITE_PATH=./data.sqlite
# Production must use an absolute path on persistent storage and set this to 1.
BACKEND_REPLICA_COUNT=1
# If your host sets WEB_CONCURRENCY in production, it must also be 1.

OPENAI_API_KEY=
SERPER_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# When enabled, recipes missing publisher nutrition/time data get LLM estimates
# that are labeled as estimated instead of being dropped from results.
RECIPE_AI_ESTIMATION=true
RECIPE_ESTIMATION_MODEL=gpt-4o-mini

APPLE_BUNDLE_ID=com.chilltech.pantrio
APPLE_APP_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY_BASE64=
APPLE_ROOT_CERTIFICATES_BASE64_JSON=[]
APPLE_ALLOWED_ENVIRONMENTS=Sandbox
APPLE_ALLOW_SANDBOX_IN_PRODUCTION=false

# Sign in with Apple web-service credentials used only to exchange and revoke
# login tokens. These are separate from the App Store/IAP credentials above.
APPLE_SIGN_IN_CLIENT_ID=com.chilltech.pantrio
APPLE_SIGN_IN_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY_BASE64=
# A separate random 32-byte key, base64 encoded (for example: openssl rand -base64 32).
APPLE_SIGN_IN_TOKEN_ENCRYPTION_KEY_BASE64=
APPLE_SIGN_IN_TOKEN_ENCRYPTION_KEY_ID=v1

# Omit this value to use the built-in monthly/yearly Pantrio Pro catalog.
# Keep it on one line when supplied through a hosting provider.
APPLE_SUBSCRIPTION_PLANS_JSON=
